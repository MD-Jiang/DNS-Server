$ORIGIN example.test.
$TTL 300

@       IN SOA ns1.example.test. admin.example.test. (
                2025090802 ; serial (YYYYMMDDNN)
                3600       ; refresh
                600        ; retry
                86400      ; expire
                300        ; minimum
)
        IN NS  ns1.example.test.
        IN NS  ns2.example.test.

; ========== DNS 权威服务器 ==========
ns1     IN A    192.168.1.10
ns2     IN A    192.168.1.11

; ========== 路由器与网关 ==========
router  IN A    192.168.1.1          ; 主路由器
gateway IN A    192.168.1.1          ; 网关别名
fw      IN A    192.168.1.2          ; 防火墙 / OPNsense / pfSense
switch  IN A    192.168.1.3          ; 核心交换机管理 IP
ap      IN A    192.168.1.4          ; 无线 AP（接入点）管理 IP

; ========== 网络基础设施服务 ==========
adguard IN A    192.168.1.53         ; AdGuard Home（DNS 过滤/去广告）
dhcp    IN A    192.168.1.54         ; DHCP 服务器
ntp     IN A    192.168.1.55         ; 时间同步服务器
vpn     IN A    192.168.1.56         ; VPN 入口（WireGuard/OpenVPN）
proxy   IN A    192.168.1.57         ; 反向代理（Nginx / Caddy）

; ========== 智能家居 / IoT（物联网）==========
home    IN A    192.168.1.60         ; Home Assistant 核心
mqtt    IN A    192.168.1.61         ; MQTT 消息代理（Mosquitto/EMQX）
zigbee  IN A    192.168.1.62         ; Zigbee2MQTT 网关
nvr     IN A    192.168.1.63         ; 监控录像机（NVR）
camera  IN A    192.168.1.64         ; 主摄像头 / 球机
doorbell IN A   192.168.1.65         ; 智能门铃
garage  IN A    192.168.1.66         ; 车库门控制器
thermo  IN A    192.168.1.67         ; 智能恒温器
light   IN A    192.168.1.68         ; 全屋灯光控制中枢
bridge  IN A    192.168.1.69         ; 智能桥接器（Philips Hue / Aqara）
speaker IN A    192.168.1.70         ; 智能音箱 / 语音助手

; ========== 多媒体与娱乐 ==========
plex    IN A    192.168.1.80         ; Plex 媒体服务器
jellyfin IN A   192.168.1.81         ; Jellyfin 媒体服务器（开源）
emby    IN A    192.168.1.82         ; Emby 媒体服务器
kodi    IN A    192.168.1.83         ; Kodi 媒体中心（本地播放）
cast    IN A    192.168.1.84         ; Chromecast / 投屏设备

; ========== 本地存储与文件共享 ==========
nas     IN A    192.168.1.30         ; 主 NAS（网络附加存储）
samba   IN A    192.168.1.30         ; SMB 文件共享别名
nfs     IN A    192.168.1.30         ; NFS 共享别名
ftp     IN A    192.168.1.31         ; FTP 服务器（如 FileZilla）

; ========== 核心业务服务器（Web / App / API）==========
www     IN A    192.168.1.100        ; 网站主站
@       IN A    192.168.1.100        ; 裸域指向主站
api     IN A    192.168.1.101        ; RESTful API 网关
app     IN A    192.168.1.102        ; 应用服务器（如 Node.js / Java）
lb      IN CNAME www.example.test.   ; 负载均衡器别名

; ========== 本地数据库集群 ==========
db      IN A    192.168.1.103        ; 通用数据库别名（指向主库）
postgres IN A   192.168.1.110        ; PostgreSQL 关系型数据库
mysql   IN A    192.168.1.111        ; MySQL / MariaDB 数据库
mongodb IN A    192.168.1.112        ; MongoDB 文档数据库
redis   IN A    192.168.1.113        ; Redis 缓存数据库
influx  IN A    192.168.1.114        ; InfluxDB 时序数据库（监控数据）
elastic IN A    192.168.1.115        ; Elasticsearch 搜索引擎/日志
mq      IN A    192.168.1.105        ; RabbitMQ 消息队列（保留旧配置）

; ========== 开发与运维工具 ==========
git     IN A    192.168.1.120        ; Gitea / GitLab 代码仓库
registry IN A   192.168.1.121        ; Docker 私有镜像仓库
vault   IN A    192.168.1.122        ; HashiCorp Vault 密钥管理
jenkins IN A    192.168.1.123        ; Jenkins CI/CD 持续集成
grafana IN A    192.168.1.124        ; Grafana 监控可视化
prom    IN A    192.168.1.125        ; Prometheus 监控采集
logs    IN A    192.168.1.126        ; ELK / Loki 日志聚合面板

; ========== 邮件服务 ==========
mail    IN A    192.168.1.20
@       IN MX 10 mail.example.test.
smtp    IN CNAME mail.example.test.
imap    IN CNAME mail.example.test.

; ========== 本地开发 / 测试环境 ==========
dev     IN A    192.168.2.10         ; 开发服务器
staging IN A    192.168.2.20         ; 预发布/联调环境

; ========== 本地专用别名（常用简写）==========
dns     IN A    192.168.1.10         ; 指向你自己的 DNS 服务器（方便测试）
gw      IN A    192.168.1.1          ; 快速访问网关
storage IN A    192.168.1.30         ; 快速访问存储

; ========== IPv6 支持（预留）==========
ipv6    IN AAAA 2001:db8:1::100
www     IN AAAA 2001:db8:1::100
api     IN AAAA 2001:db8:1::101

; ========== 文本验证 / SPF 反垃圾邮件 ==========
txt     IN TXT  "Domain verification for example.test"
_spf    IN TXT  "v=spf1 mx ip4:192.168.1.20 ~all"